# ============================================
# RL Transportes — Environment Variables (PROD)
# Copie para .env.production na raiz do monorepo
# ============================================

# ------------------------------------------
# Database (PostgreSQL no Docker)
# ------------------------------------------
DB_NAME=rl_transportes
DB_USER=rl
DB_PASSWORD=TROCAR_POR_SENHA_FORTE_32_CHARS
DATABASE_URL=postgresql://rl:TROCAR_POR_SENHA_FORTE_32_CHARS@postgres:5432/rl_transportes?schema=public

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------
# JWT (gerar: openssl rand -hex 32)
# ------------------------------------------
JWT_SECRET=TROCAR_POR_SECRET_64_CHARS
JWT_REFRESH_SECRET=TROCAR_POR_SECRET_64_CHARS_DIFERENTE
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# Deploy / CORS
# ------------------------------------------
NODE_ENV=production
DEPLOY_ENV=production
CORS_ORIGIN=https://rl.seudominio.com.br
AUTH_HTTP_ONLY_COOKIES=1

# ------------------------------------------
# URLs públicas + SSL
# ------------------------------------------
PUBLIC_API_URL=https://rl.seudominio.com.br
NEXT_PUBLIC_API_URL=https://rl.seudominio.com.br
SSL_DOMAIN=rl.seudominio.com.br
PORTAL_PUBLIC_BASE_URL=https://rl.seudominio.com.br

# ------------------------------------------
# S3 / Object Storage
# ------------------------------------------
# Oracle Object Storage (produção):
AWS_S3_BUCKET=rl-transportes
AWS_ACCESS_KEY_ID=TROCAR_POR_ORACLE_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TROCAR_POR_ORACLE_S3_SECRET_KEY
AWS_REGION=sa-saopaulo-1
STORAGE_ENDPOINT=https://objectstorage.sa-saopaulo-1.oraclecloud.com
STORAGE_PUBLIC_BASE_URL=https://objectstorage.sa-saopaulo-1.oraclecloud.com/n/SEU_NAMESPACE/b/rl-transportes/o

# MinIO (fallback local no compose):
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_PUBLIC_BASE_URL=http://minio:9000/rl-transportes
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROCAR_MINIO_PASSWORD

# ------------------------------------------
# NFS-e (IPM / Atende.Net)
# ------------------------------------------
NFSE_IPM_BASE_URL=
NFSE_IPM_PRESTADOR_CNPJ=
NFSE_IPM_PRESTADOR_TOM=
NFSE_IPM_SENHA=
NFSE_IPM_MUNICIPIO_IBGE=4208203
NFSE_IPM_CERT_PATH=
NFSE_IPM_CERT_PASS=

# ------------------------------------------
# WhatsApp Business API
# ------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------
# Google Vision (OCR)
# ------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_JSON=

# ------------------------------------------
# Feature phases
# ------------------------------------------
FEATURE_PHASES=operational

# ------------------------------------------
# Observabilidade (Sentry)
# ------------------------------------------
SENTRY_DSN=
SENTRY_ENABLED=false

# ------------------------------------------
# Seed produção (primeiro deploy)
# ------------------------------------------
SEED_ADMIN_EMAIL=admin@rltransportes.com.br
SEED_ADMIN_CPF=52998224725
SEED_ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE
SEED_TENANT_ID=default
SEED_TENANT_NOME=RL Transportes — Itajaí
ALLOW_PROD_SEED=1

# ------------------------------------------
# Segurança
# ------------------------------------------
CHAOS_ENGINE_ENABLED=0
