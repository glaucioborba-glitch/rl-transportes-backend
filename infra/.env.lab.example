# Perfil DEMO — só LAN HTTP (rllab). NÃO usar no deploy AWS/HTTPS.
# Produção: ver infra/.env.production.example (CSRF=1, cookies Secure, headers ligados).

AUTH_COOKIE_SECURE=0
CSRF_ENABLED=0
SECURITY_HEADERS_ENFORCE=0
PORTAL_HTTP_ONLY_COOKIES=1
AUTH_HTTP_ONLY_COOKIES=1
NEXT_PUBLIC_PORTAL_COOKIE_AUTH=1

# Site no :3000, API no :3001 (não apontar NEXT_PUBLIC_API_URL para a porta do Next).
# PUBLIC_API_URL=http://IP-DA-LAN:3001
# NEXT_PUBLIC_API_URL=http://IP-DA-LAN:3001
# CORS_ORIGIN=http://IP-DA-LAN:3000
# PORTAL_PUBLIC_BASE_URL=http://IP-DA-LAN:3000
