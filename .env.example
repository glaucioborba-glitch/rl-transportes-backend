# Copie para .env na raiz do monorepo
#
# Com Docker (docker compose up -d postgres redis): usuário postgres, senha postgres, DB rl — igual a este URL.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rl?schema=public

JWT_SECRET=defina_um_segredo_longo
JWT_REFRESH_SECRET=defina_outro_segredo_longo
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Nest em 3001; Next.js em 3000 (NEXT_PUBLIC_API_URL=http://localhost:3001).
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Chaos Monkey RL (testes de resiliência — rotas POST /admin/chaos/*). Em produção: CHAOS_ENGINE_ENABLED=0 ou omita.
# CHAOS_ENGINE_ENABLED=1
# CHAOS_ENGINE_ENABLED=0

# --- E-mail transacional (recuperação de senha no portal) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="RL Transportes <nao-responder@rl.com>"
# Link base nos e-mails (sem barra final). Default: https://app.rltransportes.com.br
# PORTAL_RESET_LINK_BASE=https://app.rltransportes.com.br

# --- WhatsApp Business (notificações operacionais e financeiras) ---
# WHATSAPP_ENABLED=false
# WHATSAPP_PROVIDER=meta
# WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_OPERACIONAL=rl_operacional_armazenamento
# WHATSAPP_TEMPLATE_FINANCEIRO=rl_financeiro_fatura_consolidada
# PORTAL_PUBLIC_BASE_URL=http://localhost:3000

# --- Segurança HTTP / multi-ambiente ---
# Lista explícita (prioridade sobre tudo): vírgula, origens exatas do(s) front(s).
# CORS_ORIGIN=http://localhost:3000
#
# Sem CORS_ORIGIN: em desenvolvimento o backend usa fallback (localhost:3000 e :3001).
# CORS_ORIGIN_DEV=http://localhost:3000
#
# Homolog / QA / staging (defina também DEPLOY_ENV se NODE_ENV não for "production"):
# DEPLOY_ENV=qa
# CORS_ORIGIN_QA=https://qa.rltransportes.com
# CORS_ORIGIN_HOMOLOG=https://homolog.rltransportes.com
#
# Produção: use CORS_ORIGIN_PROD ou defina CORS_ORIGIN no .env de deploy.
# NODE_ENV=production
# CORS_ORIGIN_PROD=https://portal.rltransportes.com
#
# Cookies cross-site (API e portal em domínios diferentes): frequentemente none + Secure.
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=1
# FORCE_HTTPS_COOKIES=1
#
# Anti-CSRF double-submit (cookie rl_csrf + header X-CSRF-Token). Desligado por padrão para não quebrar integrações.
# Com CSRF_ENABLED=1, o front deve definir NEXT_PUBLIC_CSRF_ENABLED=1 e enviar o header em POST/PATCH/PUT/DELETE.
# CSRF_ENABLED=0

# Middleware global: headers x-device-* e x-session-id com Bearer/cookies.
# Default — development: permissivo; production: bloqueia sem conjunto completo.
# SECURITY_HEADERS_ENFORCE=1   # força validação também em dev
# SECURITY_HEADERS_ENFORCE=0   # desliga bloqueio (útil para testes locais)

# Swagger/OpenAPI: em produção permanece desligado salvo SWAGGER_ENABLED=1.
# SWAGGER_ENABLED=0
# Cookies HttpOnly para JWT (staff web). Requer CORS_ORIGIN com URL exata do front (porta incluída) e header X-RL-Auth-Cookie no login/refresh.
# Intranet/staff: cookies HttpOnly (rl_at / rl_rt). O front chama /api/auth/login e repassa Set-Cookie.
AUTH_HTTP_ONLY_COOKIES=1
# Portal cliente: cookies HttpOnly rl_pat / rl_prt (requer PORTAL_HTTP_ONLY_COOKIES=1 + NEXT_PUBLIC_PORTAL_COOKIE_AUTH=1 no web).
PORTAL_HTTP_ONLY_COOKIES=1
# AUTH_COOKIE_SECURE=1
# AUTH_COOKIE_SAMESITE=lax
# Tempos máx. dos cookies (ms), opcionais:
# AUTH_ACCESS_COOKIE_MAX_MS=3600000
# AUTH_REFRESH_COOKIE_MAX_MS=604800000

# Origens CORS (vírgula). Produção: domínio exato do portal / front.
# CORS_ORIGIN=https://app.empresa.com,https://portal.empresa.com
# TRUST_PROXY=1
# Recomendado atrás de reverse proxy / load balancer (X-Forwarded-For correto no rate limit).

# Limite global de pedidos por IP (default 100 / 15 min). Health check excluído da contagem.
# RATE_LIMIT_MAX=100

# Redis (rate limit login, cache)
REDIS_HOST=localhost
REDIS_PORT=6379
# Dev sem Docker: 1 = cache/sessões degradam sem derrubar a API (REDIS_OPTIONAL=0 exige Redis)
REDIS_OPTIONAL=1

# --- Observabilidade M1 (Winston JSON + Sentry + Trace ID + Alertas) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=rl-transportes@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.2
# Header de correlação: x-correlation-id (fallback: x-request-id)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_WEBHOOK_FORMAT=slack   # slack | discord | teams
# ALERT_DEBOUNCE_MS=900000     # 15 min entre alertas iguais
# NEXT_PUBLIC_SENTRY_DSN=      # frontend Next.js (apps/web)

# Cache CEP (Redis) — autofill portal/cadastro
CACHE_CEP_TTL=86400
CEP_PROVIDER_URL=https://viacep.com.br/ws

# PDF operacional — Solicitações v2 (HTML → A4 via Puppeteer)
# Caminho absoluto do Chrome/Chromium no servidor (obrigatório se PDF_USE_LAMBDA_CHROMIUM não estiver ativo).
# Windows (exemplo): PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=
# AWS Lambda / Chromium empacotado (@sparticuz/chromium):
# PDF_USE_LAMBDA_CHROMIUM=1
# Base pública da API para o QRCode de verificação (sem barra final). Se vazio, usa protocol+host da requisição.
# API_PUBLIC_BASE_URL=https://api.suaempresa.com.br

# Dashboard de performance operacional (proxies de custo / fila / pátio)
# PERFORMANCE_CUSTO_MINUTO_PROXY=0.05
# PERFORMANCE_FILA_GARGALO_LIMITE=15
# PERFORMANCE_PATIO_CAPACIDADE_ESTIMADA=200

# Opcional: seed (prisma db seed)
# SEED_ADMIN_EMAIL=admin@rltransportes.com
# SEED_ADMIN_PASSWORD=Admin@123

# NFS-e — IPM / Atende.Net (Navegantes-SC). Nunca versionar senha real.
# NFSE_IPM_SENHA=
# NFSE_IPM_BASE_URL=https://ws-navegantes.atende.net:7443/?pg=rest&service=WNERestServiceNFSe
# NFSE_IPM_PRESTADOR_CNPJ=27692077000126
# NFSE_IPM_PRESTADOR_TOM=8221
# NFSE_IPM_MUNICIPIO_IBGE=4211306
# Tag do indicador de cancelamento no XML (ex.: tipo); alinhe ao retorno do portal.
# NFSE_IPM_TAG_CANCEL=tipo
# Certificado A1 (mTLS) — caminho absoluto ou relativo ao cwd do backend
# NFSE_IPM_CERT_PATH=./certs/rl-transportes-a1.pfx
# NFSE_IPM_CERT_PASS=
# Código LC116 / item lista serviço armazenagem (Navegantes)
# NFSE_ARM_CODIGO_SERVICO=11.04
# NFSE_ARM_ITEM_LISTA=1104
# NFSE_ARM_CNAE=5211701

# Boleto / PIX bancário (H9). Sem credenciais → sandbox com links mock no portal.
# BANK_PROVIDER=sandbox
# BANK_API_BASE_URL=
# BANK_CLIENT_ID=
# BANK_CLIENT_SECRET=
# BANK_AGENCIA=
# BANK_CONTA=
# BANK_CARTEIRA=109
# BANK_CONVENIO=

# Arquitetura modular + feature flags (H4)
# FEATURE_PHASES=full          # full (default) | operational | lean — boot enxuto operacional
# FEATURE_ANALYTICS_LAZY=1     # 0 = carrega BI no boot; 1 = lazy via POST /admin/platform/analytics-lazy/warmup
# FEATURE_BILLING_CRON_LAZY=1  # 0 = CRON diárias no boot; 1 = lazy via POST /admin/platform/billing-lazy/warmup (default em operational)
# Toggles também em tabela feature_flags + PATCH /admin/feature-flags/:chave
# FISCAL_INTEGRATION_ENABLED, GATE_AUTO_APPROVE_ENABLED (seed migration)

# GRC / Compliance (Fase 13): supervisor por e-mail (vírgula), igual conceito RH_PERF_SUPERVISOR_EMAILS
# GRC_SUPERVISOR_EMAILS=supervisor@empresa.com
# Limiar OCR portaria para incidente OPS-OCR-BACKLOG (default interno se omitido)
# GRC_OCR_BACKLOG_THRESHOLD=50
# Proxies numéricos só leitura (sem migrar outros módulos)
# GRC_RH_AUSENCIAS_PROXY=
# GRC_INCIDENTES_SEGURANCA_PROXY=
# GRC_EFICACIA_CONTROLE_DEFAULT=72
# GRC_PLANO_ACAO_CUSTO_ESTIMADO=0

# Integração / Mobilidade (Fase 14): API Key B2B formato key|clienteUuid (várias vírgula)
# INTEGRACAO_API_KEYS=
# Segredo POST interno /integracao/eventos e IoT (header X-Integracao-Interno)
# INTEGRACAO_INTERNO_SECRET=
# Rate limit por API Key / JWT cliente (req/min)
# INTEGRACAO_RATE_LIMIT_PER_MIN=120
# IP allowlist opcional (vírgula) para rotas de integração sensíveis
# INTEGRACAO_IP_ALLOWLIST=
# Webhook financeiro: assinatura HMAC opcional (canonical JSON fixo no código)
# INTEGRACAO_FINANCE_WEBHOOK_SECRET=
# SLA padrão em horas para métricas cliente-api
# INTEGRACAO_SLA_HORAS_PADRAO=72
# UUID de usuário existente para registrar auditoria de webhooks (opcional)
# INTEGRACAO_AUDITORIA_USER_ID=

# Observabilidade (Fase 15): proxies opcionais para health/dashboard sem alterar outros módulos
# OBS_WEBHOOK_QUEUE_DEPTH_PROXY=
# OBS_IA_EXEC_MS_PROXY=
# OBS_FISCAL_HEALTH_PROXY=
# OBS_RISCO_TEC_PROXY=

# IA preditiva (Fase 16): estatística local, sem APIs ML externas
# IA_PRED_DEMANDA_MESES_MAX=48
# IA_PRED_PATIO_CAPACIDADE=280
# IA_PRED_CLIMA_FATOR=1
# IA_PRED_ANOM_Z=2.5
# IA_PRED_HORA_UTIL_INI=6
# IA_PRED_HORA_UTIL_FIM=22
# IA_PRED_PERSIST_WEIGHTS=0

# Datahub (Fase 17): e-mails de GERENTE que operam Lake/ETL/Export/Quality/Obs (papel TI/Dados).
# GERENTE fora desta lista mantém só leitura BI + catálogo DW. ADMIN não precisa estar aqui.
# DATAHUB_TI_EMAILS=gerente.tech@suaempresa.com,ti.dados@suaempresa.com

# Plataforma / API pública B2B (Fase 18, sem migrations). Chaves em memória + Prisma read-only.
# Formato: apiKey|apiSecret|nome|tenantId|rpm|clienteId1,clienteId2 (último opcional; múltiplos clientes separados por ;).
# PLATAFORMA_API_CLIENTS=minha-pk|meu-secret|Parceiro A|default|120
# PLATAFORMA_GATEWAY_IP_ALLOWLIST=203.0.113.10,198.51.100.0
# PLATAFORMA_HMAC_SECRET=use-para-assinar-respostas-nfse-faturamento

# CX / Portais (Fase 20) — JWT dedicado opcional (default: anexa `:portal` ao segredo corporativo).
# PORTAL_JWT_SECRET=
# PORTAL_JWT_REFRESH_SECRET=
# PORTAL_JWT_EXPIRES_IN=1h
# PORTAL_JWT_REFRESH_EXPIRES_IN=7d
# Origem do front para montar links em recuperação de senha (mock: log no servidor).
# PORTAL_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Formato por linha: CPF/CNPJ (11 ou 14 dígitos)|senha_em_texto|tenantId|PARCEIRO (opcional; default FORNECEDOR)
# CX_PORTAL_FORNECEDOR_SEED=19131243000197|SenhaForte1|default

# Cockpit NOC/TOC (Fase 22) — capacidade pátio no mapa e supervisores (e-mail, vírgula).
# COCKPIT_PATIO_CAPACIDADE=280
# COCKPIT_SUPERVISOR_EMAILS=supervisor.operacoes@empresa.com
# Proxies opcionais (read-only agregação)
# GRC_OCR_BACKLOG_PROXY=
# COCKPIT_RH_PROD_IA_PROXY=0.82
# COCKPIT_RH_GARGALO_PROXY=
# COCKPIT_TREND_IA_7D_PROXY=0
# COCKPIT_TREND_IA_30D_PROXY=0
# COCKPIT_TREND_IA_90D_PROXY=0

# Mobile hub (Fase 21) — JWT dedicado aos apps; default usa sufixo `:mobile` sobre JWT_SECRET.
# MOBILE_JWT_SECRET=
# MOBILE_JWT_REFRESH_SECRET=
# MOBILE_JWT_EXPIRES_IN=45m
# MOBILE_JWT_REFRESH_EXPIRES_IN=30d
# PIN opcional para rotas críticas (gate-in/out): header X-Mobile-Critical-Pin
# MOBILE_CRITICAL_PIN=
# Motoristas em memória (sem migration): CPF/CNPJ|senha|protocoloPadrao (várias linhas com ; ou newline)
# MOBILE_MOTORISTA_SEED=11000000000701|SenhaForte123|PROT-SEED-01

# --- Vistoria Gate (fotos S3/R2 ou disco local) ---
# Bucket S3 ou Cloudflare R2 (forcePathStyle com endpoint customizado).
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # ou R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# URL pública das imagens (CDN ou bucket público). Omitido: URL S3 padrão ou media local.
# STORAGE_PUBLIC_BASE_URL=https://cdn.rltransportes.com
# Base da API para servir fotos locais em dev (uploads/vistorias → GET /v2/gate/vistoria/media/*)
# API_PUBLIC_BASE_URL=http://localhost:3001

# --- Hold/Release Engine (bloqueio de contêiner) ---
# Dias após vencimento do boleto para bloqueio financeiro automático (TenantConfig.parametros.operacao.diasInadimplenciaBloqueio; default 30).
# diasInadimplenciaBloqueio=30
