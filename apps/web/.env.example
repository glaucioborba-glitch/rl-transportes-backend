# API Nest (RL Transportes). Nest escuta na API_PORT (.env na raiz, normalmente 3001); Next.js dev em localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Alinhar com backend: em production o front envia X-CSRF-Token por default.
# NEXT_PUBLIC_CSRF_ENABLED=0 desliga; =1 força em development.

# Opcional: modo cookies HttpOnly para operadores (exige AUTH_HTTP_ONLY_COOKIES=1 no backend + CORS_ORIGIN com esta origem).
# NEXT_PUBLIC_AUTH_HTTP_ONLY=0

# Portal cliente: sessão persistente via cookies HttpOnly (BFF /api/portal/*). Requer PORTAL_HTTP_ONLY_COOKIES=1 no backend.
NEXT_PUBLIC_PORTAL_COOKIE_AUTH=1

# Cookie HMAC do app motorista (mesmo valor no processo Next e, se houver, no backend).
# MOTORISTA_SESSION_SECRET=

# Mapa da frota com trânsito (Maps JavaScript API). Sem esta chave, a tela usa OpenStreetMap.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# ETA até o terminal: GOOGLE_MAPS_API_KEY no .env da raiz (Routes API, só no Nest).

# Backend: CORS_ORIGIN deve incluir a URL do Next (ex.: http://localhost:3000).
