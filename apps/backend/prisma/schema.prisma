  latencyMs       Int?     @map("latency_ms")
  batteryPct      Int?     @map("battery_pct")
  errors          Json     @default("[]")
  offlineUsageSec Int      @default(0) @map("offline_usage_sec")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([createdAt])
  @@map("mobile_telemetry")
}

model MobileHubOp {
  id        String   @id @default(uuid())
  tenantId  String   @default("default") @map("tenant_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  canal     String   @db.VarChar(30)
  acao      String   @db.VarChar(120)
  payload   Json
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([createdAt])
  @@map("mobile_hub_ops")
}

